// AI Parlance — minimal MySQL dialect fixture for `aip emit mysql`

app MysqlDemo @0.1 {
  database mysql
  auth api_key
}

entity Item {
  timestamps
  name: string required
  sku: string required unique
  active: bool default(true)
}

crud Item

api {
  prefix "/v1"
  format json
}

seed Item {
  name: "Sample"
  sku: "SKU-1"
  active: true
}
