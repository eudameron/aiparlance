{
  "name": "@aiparlance/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI Parlance CLI — aip parse | validate | emit",
  "bin": {
    "aip": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@aiparlance/parser": "0.0.0",
    "@aiparlance/validator": "0.0.0",
    "@aiparlance/sql": "0.0.0",
    "@aiparlance/openapi": "0.0.0",
    "@aiparlance/typescript": "0.0.0"
  }
}
