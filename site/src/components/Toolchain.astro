---
import type { Locale, Messages } from "@/i18n";
import { localePath } from "@/i18n";

interface Props {
  locale: Locale;
  t: Messages;
}

const { locale, t } = Astro.props;

function itemHref(item: { slug: string; docs: string }): { href: string; external: boolean } {
  if (item.slug) {
    return { href: localePath(locale, `/emitters/${item.slug}`), external: false };
  }
  return {
    href: `https://docs.aiparlance.org/${locale}/emitters/${item.docs}`,
    external: true,
  };
}
---

<section class="section toolchain" id="toolchain">
  <div class="container">
    <h2 class="section-title">{t.toolchain.title}</h2>
    <p class="toolchain-sub">{t.toolchain.subtitle}</p>
    <ul class="toolchain-grid">
      {
        t.toolchain.items.map((item) => {
          const { href, external } = itemHref(item);
          return (
            <li>
              <a
                class="toolchain-card"
                href={href}
                rel={external ? "noopener" : undefined}
              >
                <div class="toolchain-card-head">
                  <h3>{item.name}</h3>
                  <span class="toolchain-badge">{item.badge}</span>
                </div>
                <p>{item.body}</p>
              </a>
            </li>
          );
        })
      }
    </ul>
    <div class="toolchain-cta">
      <a class="btn btn-primary" href={localePath(locale, "/emitters")}>
        {t.toolchain.cta}
      </a>
      <a
        class="btn btn-ghost"
        href={`https://docs.aiparlance.org/${locale}/getting-started`}
        rel="noopener"
      >
        {t.toolchain.ctaSecondary}
      </a>
    </div>
  </div>
</section>

<style>
  .toolchain-sub {
    color: var(--text-muted);
    max-width: 62ch;
    margin: -0.5rem 0 2rem;
  }
  .toolchain-grid {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .toolchain-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 900px) {
    .toolchain-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1200px) {
    .toolchain-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  .toolchain-card {
    display: block;
    height: 100%;
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .toolchain-card:hover {
    border-color: var(--accent-cyan);
    text-decoration: none;
  }
  .toolchain-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.65rem;
  }
  .toolchain-card h3 {
    margin: 0;
    font-size: 1.05rem;
  }
  .toolchain-badge {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-cyan);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
  }
  .toolchain-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .toolchain-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
