---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getMessages, locales, localePath, type Locale } from "@/i18n";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;
const t = getMessages(locale);
const h = t.emittersHub;

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: h.heading,
  description: h.description,
  itemListElement: h.featured.map((item, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: item.name,
    url: `https://aiparlance.org/${locale}/emitters/${item.slug}`,
  })),
};
---

<Layout locale={locale} t={t} title={h.title} description={h.description} path="emitters">
  <Header locale={locale} t={t} path="emitters" />
  <main>
    <section class="section mkt-hero">
      <div class="container">
        <a class="back" href={localePath(locale)}>{h.back}</a>
        <span class="badge">{h.badge}</span>
        <h1>{h.heading}</h1>
        <p class="lead">{h.lead}</p>
        <p class="honesty">{h.honesty}</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <h2 class="section-title">{h.featuredTitle}</h2>
        <p class="section-lead">{h.featuredLead}</p>
        <ul class="featured-grid">
          {
            h.featured.map((item) => (
              <li>
                <a class="featured-card" href={localePath(locale, `/emitters/${item.slug}`)}>
                  <div class="featured-head">
                    <h3>{item.name}</h3>
                    <code>{item.command}</code>
                  </div>
                  <p>{item.benefit}</p>
                  <span class="more">→</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section matrix-section">
      <div class="container">
        <h2 class="section-title">{h.matrixTitle}</h2>
        <p class="section-lead">{h.matrixLead}</p>
        <ul class="matrix-grid">
          {
            h.matrix.map((item) => {
              const href = item.slug
                ? localePath(locale, `/emitters/${item.slug}`)
                : `https://docs.aiparlance.org/${locale}/emitters/${item.docs}`;
              const external = !item.slug;
              return (
                <li>
                  <a class="matrix-card" href={href} rel={external ? "noopener" : undefined}>
                    <strong>{item.name}</strong>
                    <code>{item.command}</code>
                    <span>{item.blurb}</span>
                  </a>
                </li>
              );
            })
          }
        </ul>
        <div class="actions">
          <a class="btn btn-primary" href={`https://docs.aiparlance.org/${locale}/emitters`} rel="noopener">
            {h.docsMaturity}
          </a>
          <a class="btn btn-ghost" href={`https://docs.aiparlance.org/${locale}/getting-started`} rel="noopener">
            {h.gettingStarted}
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer t={t} locale={locale} />
  <script type="application/ld+json" set:html={JSON.stringify(itemList)} />
</Layout>

<style>
  .mkt-hero {
    padding-top: 3rem;
  }
  .back {
    display: inline-block;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }
  .badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--accent-cyan);
    margin-bottom: 1rem;
  }
  h1 {
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    letter-spacing: -0.03em;
    margin: 0 0 1rem;
  }
  .lead {
    color: var(--text-muted);
    max-width: 62ch;
    font-size: 1.05rem;
    margin: 0 0 1rem;
  }
  .honesty {
    margin: 0;
    max-width: 62ch;
    font-size: 0.92rem;
    color: var(--text-muted);
    border-left: 2px solid var(--accent-purple);
    padding-left: 0.85rem;
  }
  .section-lead {
    color: var(--text-muted);
    max-width: 60ch;
    margin: -0.5rem 0 1.75rem;
  }
  .featured-grid,
  .matrix-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 800px) {
    .featured-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .matrix-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .matrix-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  .featured-card,
  .matrix-card {
    display: block;
    height: 100%;
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .featured-card:hover,
  .matrix-card:hover {
    border-color: var(--accent-cyan);
    text-decoration: none;
  }
  .featured-head {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-bottom: 0.75rem;
  }
  .featured-card h3,
  .matrix-card strong {
    margin: 0;
    font-size: 1.1rem;
  }
  .featured-card code,
  .matrix-card code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-cyan);
  }
  .featured-card p,
  .matrix-card span {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .matrix-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .more {
    display: inline-block;
    margin-top: 0.85rem;
    color: var(--accent-cyan);
    font-weight: 600;
  }
  .matrix-section {
    background: var(--bg-elevated);
    border-block: 1px solid var(--border);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
</style>
